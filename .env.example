# Copia questo file in .env e compila i valori reali
# Il file .env NON va mai committato su git

# Supabase - connection string PostgreSQL
# Trovalo in: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Chiave segreta Flask (genera con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-questa-chiave-in-produzione

# Email admin separate da virgola
ADMIN_EMAILS=fvedani23@gmail.com

# Registrazione pubblica: true = chiunque può creare un account, false = solo l'admin crea gli account
REGISTRATION_OPEN=false
